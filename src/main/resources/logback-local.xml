<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- traceId는 TraceIdFilter가 MDC에 심는다 -->
    <property name="LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} [%X{traceId}] %-5level %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <logger name="timmy.todo.server" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
